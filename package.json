    "hast-util-to-html": "^9.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.5",
    "@types/node": "^24",
    "hast-util-select": "^6.0.4",
    "pagefind": "^1.5.2",
    "typescript": "^6",
    "vitest": "^5.0.2"
