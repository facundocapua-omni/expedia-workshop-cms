---
import Base from './Base.astro';
import { loadSiteData } from '../lib/data';
import { computeFacts, interpolateFacts } from '../lib/facts';

interface Props {
  title: string;
  kicker: string;
  lede?: string;
  meta?: string[];
  /** A session's expected outcomes, shown in the masthead. */
  outcomes?: string[];
  kind: 'idea' | 'agenda' | 'register' | 'session';
}
const { title, kicker, kind, outcomes = [] } = Astro.props;
const facts = computeFacts(await loadSiteData());
const lede = Astro.props.lede ? interpolateFacts(Astro.props.lede, facts) : undefined;
const meta = (Astro.props.meta ?? []).map((m) => interpolateFacts(m, facts));
---
<Base title={title} description={lede ?? title} kind={kind}>
  <div class="wrap">
    <header class="mast" data-slide>
      <p class="kicker">{kicker}</p>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      {meta.length > 0 && <p class="meta">{meta.map((m) => <span>{m}</span>)}</p>}
      {outcomes.length > 0 && (
        <div class="outcomes">
          <p class="label">Expected outcomes</p>
          <ul>{outcomes.map((o) => <li>{o}</li>)}</ul>
        </div>
      )}
    </header>
    <div class="cols">
      <nav class="index" aria-label="Contents" data-index></nav>
      <main data-pagefind-body data-pagefind-meta={`kind:${kind}`}>
        <slot />
      </main>
    </div>
  </div>
</Base>
